# API protection
STOCKLAB_API_KEY=

# Data
STOCKLAB_DATA_PROVIDER=yfinance
STOCKLAB_CSV_DIR=./data
STOCKLAB_CACHE=1

# AI research agent (server-side only)
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
LLM_BASE_URL=https://api.openai.com/v1

# Browser security
STOCKLAB_CORS_ORIGINS=http://localhost:8000

# Persistence: PostgreSQL is recommended for Vercel; SQLite is local/dev only.
# STOCKLAB_DATABASE_URL=postgresql://stocklab:change-me@localhost:5432/stocklab
# Optional cache location; Vercel code storage is read-only, so the app uses /tmp automatically there.
# STOCKLAB_CACHE_DIR=./.stocklab_cache

# Worker
STOCKLAB_WORKER_MODE=thread

# Sessions
STOCKLAB_SESSION_TTL_HOURS=24
